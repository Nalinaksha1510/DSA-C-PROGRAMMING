4.INFIX TO POSTFIX EXPRESSION

#include<stdio.h>
#include<ctype.h>
#include<conio.h>

int main()
{
    char infix[50], postfix[50], stack[50];
    int top = -1;
    int i=0, j=0;

    printf("Enter infix expression: ");
    scanf("%s", infix);

    while(infix[i] != '\0')
    {
        char ch = infix[i];
        if(isalnum(ch))
        {
            postfix[j++] = ch;
        }
        else if(ch == '(')
        {
            stack[++top] = ch;
        }
        else if(ch == ')')
        {
            while(top!=-1 && stack[top]!='(')
            {
                postfix[j++] = stack[top--];
            }
            top--;
        }
        else
        {
            while(top!=-1 && stack[top]!='(' &&
                 ((ch=='*' || ch=='/') && (stack[top]=='+' || stack[top]=='-')))
            {
                postfix[j++] = stack[top--];
            }
            stack[++top] = ch;
        }
        i++;
    }

    while(top!=-1)
    {
        postfix[j++] = stack[top--];
    }
    postfix[j] = '\0';

    printf("postfix Expression: %s\n", postfix);
    getch();
    return 0;
}



5.POSTFIX EXPRESSION

#include<stdio.h>
#include<ctype.h>
#include<conio.h>

int main()
{
    int stack[50];
    int top = -1;

    char postfix[50];
    int i, op1, op2, result;

    printf("Enter postfix expression:");
    scanf("%s", postfix);

    for(i=0; postfix[i]!='\0'; i++)
    {
        char ch = postfix[i];
        if(isdigit(ch))
        {
            stack[++top] = ch - '0';
        }
        else
        {
            op2 = stack[top--];
            op1 = stack[top--];

            switch(ch)
            {
                case '+':
                    result = op1 + op2;
                    break;
                case '-':
                    result = op1 - op2;
                    break;
                case '*':
                    result = op1 * op2;
                    break;
                case '/':
                    result = op1 / op2;
                    break;
            }
            stack[++top] = result;
        }
    }
    printf("Result = %d\n", stack[top]);
    getch();
    return 0;
}



7.SINGLY LINKED LIST

#include<stdio.h>
#include<stdlib.h>

struct node{
    int data; struct node *link;
};
struct node *head = NULL;

void insert_at_front(int value){
    struct node n=(struct node)malloc(sizeof(struct node));
    n->data=value; n->link=head; head=n;
}

void insert_at_end(int value){
    struct node n=(struct node)malloc(sizeof(struct node));
    n->data=value; n->link=NULL;
    if(head==NULL) head=n;
    else{
        struct node *t=head;
        while(t->link!=NULL) t=t->link;
        t->link=n;
    }
}

void insert_middle(int key,int value){
    struct node n=(struct node)malloc(sizeof(struct node));
    struct node *t=head;
    while(t!=NULL && t->data!=key) t=t->link;
    if(t==NULL){
        printf("Node with value %d not found.\n",key);
        return;
    }
    n->data=value; n->link=t->link; t->link=n;
}

void delete_node(int value){
    struct node *t=head,*p=NULL;
    if(t!=NULL && t->data==value){
        head=t->link; free(t);
        printf("Node with value %d deleted.\n",value);
        return;
    }
    while(t!=NULL && t->data!=value){
        p=t; t=t->link;
    }
    if(t==NULL){
        printf("Node with value %d not found.\n",value);
        return;
    }
    p->link=t->link; free(t);
    printf("Node with value %d deleted.\n",value);
}

void display(){
    struct node *t=head;
    if(t==NULL){
        printf("List is empty.\n");
        return;
    }
    printf("Linked list: ");
    while(t!=NULL){
        printf("%d -> ",t->data); t=t->link;
    }
    printf("NULL\n");
}

void main(){
    int choice,value,key;
    while(1){
        printf("\n---Singly Linked List---\n");
        printf("\n1.Insert at beginning");
        printf("\n2.Insert at end");
        printf("\n3.Insert after a node");
        printf("\n4.Delete a node");
        printf("\n5.Display list");
        printf("\n6.Exit");
        printf("\n Enter your choice: ");
        scanf("%d", &choice);
        switch(choice){
            case 1:
                printf("\n Enter value to insert at beginning ");
                scanf("%d", &value);
                insert_at_front(value);
                display();
                break;
            case 2:
                printf("\n Enter value to insert at end ");
                scanf("%d", &value);
                insert_at_end(value);
                display();
                break;
            case 3:
                printf("\n Enter key after which to insert ");
                scanf("%d", &key);
                printf("\n Enter value to insert: ");
                scanf("%d", &value);
                insert_middle(key, value);
                display();
                break;
            case 4:
                printf("\n Enter value to delete ");
                scanf("%d", &value);
                delete_node(value);
                display();
                break;
            case 5:
                display();
                break;
            case 6:
                printf("\n Exiting program\n");
                exit(0);
            default:
                printf("\n Invalid choice\n");
        }
    }
}



8.BINARY TREE AND TRAVERSAL TECHNIQUES

#include<stdio.h>
#include<conio.h>
#include<stdlib.h>

struct Node{
    int data;
    struct Node* left;
    struct Node* right;
};

struct Node* createNode(int data){
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = data;
    newNode->left = NULL;
    newNode->right = NULL;
    return newNode;
}

void inorderTraversal(struct Node* root){
    if(root!=NULL){
        inorderTraversal(root->left);
        printf("%d ", root->data);
        inorderTraversal(root->right);
    }
}

void preorderTraversal(struct Node* root){
    if(root!=NULL){
        printf("%d ", root->data);
        preorderTraversal(root->left);
        preorderTraversal(root->right);
    }
}

void postorderTraversal(struct Node* root){
    if(root!=NULL){
        postorderTraversal(root->left);
        postorderTraversal(root->right);
        printf("%d ", root->data);
    }
}

int main(){
    int a,b,c,d,e;
    struct Node* root;

    printf("Enter root value  ");
    scanf("%d",&a);
    printf("Enter left child value  ");
    scanf("%d",&b);
    printf("Enter right child value  ");
    scanf("%d",&c);
    printf("Enter left left child value  ");
    scanf("%d",&d);
    printf("Enter left right child value  ");
    scanf("%d",&e);

    root = createNode(a);
    root->left = createNode(b);
    root->right = createNode(c);
    root->left->left = createNode(d);
    root->left->right = createNode(e);

    printf("Inorder Traversal  ");
    inorderTraversal(root);
    printf("\n");

    printf("Preorder Traversal  ");
    preorderTraversal(root);
    printf("\n");

    printf("Postorder Traversal  ");
    postorderTraversal(root);
    printf("\n");

    getch();
    return 0;
}



